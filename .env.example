# =============================================================================
# BioCypher 2.0 — Environment Configuration Template
# =============================================================================
# COPY THIS FILE TO .env AND POPULATE YOUR PRODUCTION VALUES:
#   cp .env.example .env
#
# CRITICAL: NEVER COMMIT .env TO VERSION CONTROL.
# =============================================================================

# Flask Session & Cryptographic Key
# Generate a secure 64-character token using:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-cryptographically-strong-secret-token

# Environment & Debug Flags (ALWAYS FALSE in production!)
FLASK_ENV=production
FLASK_DEBUG=False

# Host & Port Binding
FLASK_HOST=127.0.0.1
PORT=5000

# Secure Admin Portal Credentials
# To generate a salted hash for your admin password:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('YourSecurePasswordHere', method='pbkdf2:sha256:600000'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=pbkdf2:sha256:600000$replaceWithYourActualPBKDF2SaltAndHash

# Cookie Security (Set to True if serving over HTTPS / SSL)
SESSION_COOKIE_SECURE=False

# CORS Allowed Origins (Comma-separated list; leave empty or specify trusted domains)
ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# Rate Limiting Parameters (Requests per sliding window)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL_MAX=60
RATE_LIMIT_HEAVY_CV_MAX=15
RATE_LIMIT_AUTH_MAX=5
